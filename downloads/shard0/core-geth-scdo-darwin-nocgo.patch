diff --git a/consensus/lyra2/lyra2_cgo.go b/consensus/lyra2/lyra2_cgo.go
new file mode 100644
index 0000000..6d6af8d
--- /dev/null
+++ b/consensus/lyra2/lyra2_cgo.go
@@ -0,0 +1,45 @@
+//go:build cgo
+
+package lyra2
+
+/*
+#cgo CFLAGS: -std=gnu99
+#include "Lyra2.h"
+#include <stdlib.h>
+*/
+import "C"
+import (
+	"encoding/binary"
+	"math/big"
+	"unsafe"
+
+	"github.com/ethereum/go-ethereum/common"
+)
+
+func (lyra2 *Lyra2) calcHash(headerBytes []byte, nonce uint64, tcost int) *big.Int {
+	var lyra2_ctx unsafe.Pointer = C.LYRA2_create()
+	result := lyra2.compute(lyra2_ctx, headerBytes, nonce, tcost)
+	C.LYRA2_destroy(lyra2_ctx)
+
+	return result.Big()
+}
+
+func bytesToHash(in unsafe.Pointer) common.Hash {
+	return *(*common.Hash)(in)
+}
+
+func (lyra2 *Lyra2) compute(ctx unsafe.Pointer, blockBytes []byte, nonce uint64, tcost int) common.Hash {
+	binary.BigEndian.PutUint64(blockBytes[len(blockBytes)-8:], nonce)
+
+	var in unsafe.Pointer = C.CBytes(blockBytes)
+	var out unsafe.Pointer = C.malloc(common.HashLength)
+
+	C.LYRA2(ctx, out, common.HashLength, in, C.int32_t(len(blockBytes)), C.int32_t(tcost))
+
+	hash := bytesToHash(out)
+
+	C.free(in)
+	C.free(out)
+
+	return hash
+}
diff --git a/consensus/lyra2/lyra2_nocgo.go b/consensus/lyra2/lyra2_nocgo.go
new file mode 100644
index 0000000..83b477d
--- /dev/null
+++ b/consensus/lyra2/lyra2_nocgo.go
@@ -0,0 +1,18 @@
+//go:build !cgo
+
+// SCDO darwin/arm64 build (CGO_ENABLED=0): Lyra2 (MintMe) PoW hashing needs the C implementation.
+// It is not used by SCDO shard0 (Ethash); any Lyra2 seal fails verification in this build.
+package lyra2
+
+import (
+	"math/big"
+
+	"github.com/ethereum/go-ethereum/log"
+)
+
+var maxHash = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+
+func (lyra2 *Lyra2) calcHash(headerBytes []byte, nonce uint64, tcost int) *big.Int {
+	log.Error("Lyra2 PoW is not available in this CGO-disabled build")
+	return new(big.Int).Set(maxHash)
+}
